{
	"version": "2",
	"label": "Newsletter subscribe",
	"description": "Email signup. Stores submissions via the form module.",
	"item": [
		{
			"type": "textarea",
			"name": "heading",
			"label": "Heading",
			"lines": "2",
			"default": ""
		},
		{
			"type": "textarea",
			"name": "text",
			"label": "Text",
			"lines": "8",
			"html": "B"
		},
		{
			"type": "text",
			"name": "email_label",
			"label": "Email label",
			"default": "Email"
		},
		{
			"type": "text",
			"name": "email_placeholder",
			"label": "Email placeholder",
			"default": "Your email"
		},
		{
			"type": "text",
			"name": "submit_text",
			"label": "Submit text",
			"default": "Subscribe"
		},
		{
			"type": "text",
			"name": "success_message",
			"label": "Success message",
			"default": "Thank you for subscribing."
		},
		{
			"type": "text",
			"name": "sending_message",
			"label": "Sending message",
			"default": "Sending ..."
		},
		{
			"type": "text",
			"name": "error_message",
			"label": "Invalid email message",
			"default": "Please enter a valid email."
		},
		{
			"type": "subtitle",
			"label": "Notification"
		},
		{
			"type": "repeater",
			"name": "emails",
			"label": "People receiving notifications",
			"fields": [
				{
					"type": "text",
					"name": "email",
					"label": "Email"
				}
			]
		},
		{
			"type": "subtitle",
			"label": "Automatic confirmation to visitor"
		},
		{
			"type": "select",
			"name": "autoreply",
			"label": "Reply to person",
			"values": {
				"0": "No auto reply",
				"1": "Yes, automatic reply email"
			},
			"default": "0"
		},
		{
			"type": "textarea",
			"name": "autoreply_text",
			"label": "Reply text",
			"lines": "8",
			"default": "Thank you for subscribing.\r\n\r\n",
			"help": "Use [email] and [codeurl] (if confirm is on)"
		},
		{
			"type": "link",
			"name": "autoreply_html",
			"label": "Reply HTML",
			"targets": "none,emailer/basic",
			"help": "If selected, autoreply text is ignored"
		},
		{
			"type": "text",
			"name": "autoreply_subject",
			"label": "Reply subject",
			"default": "Subscription"
		},
		{
			"type": "select",
			"name": "confirm",
			"label": "Confirm code link",
			"values": {
				"0": "No confirmation",
				"1": "Yes, confirmation link in email"
			},
			"default": "0"
		},
		{
			"type": "textarea",
			"name": "confirm_success_text",
			"label": "Confirm success text",
			"lines": "8",
			"default": "Thank you for confirming your email.\r\n\r\n"
		},
		{
			"type": "link",
			"name": "confirm_html",
			"label": "Confirm success HTML",
			"targets": "none,emailer/basic"
		},
		{
			"type": "text",
			"name": "confirm_subject",
			"label": "Confirm subject",
			"default": "Email confirmed"
		},
		{
			"type": "text",
			"name": "confirm_success_message",
			"label": "Confirm success on page",
			"default": "Email confirmed"
		},
		{
			"type": "subtitle",
			"label": "Mailchimp"
		},
		{
			"type": "select",
			"name": "add_mailchimp",
			"label": "Add to Mailchimp",
			"values": {
				"0": "No",
				"1": "Yes"
			},
			"default": "0"
		},
		{
			"type": "text",
			"name": "mailchimp_api_key",
			"label": "Mailchimp API key",
			"default": ""
		},
		{
			"type": "text",
			"name": "mailchimp_list_id",
			"label": "Mailchimp list ID",
			"default": ""
		},
		{
			"type": "subtitle",
			"label": "Campaign Monitor"
		},
		{
			"type": "select",
			"name": "add_cm",
			"label": "Add to CM list",
			"values": {
				"0": "No",
				"1": "Yes"
			},
			"default": "0"
		},
		{
			"type": "text",
			"name": "cm_api_key",
			"label": "CM API key",
			"default": ""
		},
		{
			"type": "text",
			"name": "cm_api_url",
			"label": "CM API URL",
			"default": ""
		},
		{
			"type": "text",
			"name": "cm_list_id",
			"label": "CM list ID",
			"default": ""
		},
		{
			"type": "subtitle",
			"label": "Sendgrid"
		},
		{
			"type": "select",
			"name": "add_sendgrid",
			"label": "Add to Sendgrid contacts",
			"values": {
				"0": "No",
				"1": "Yes"
			},
			"default": "0"
		},
		{
			"type": "text",
			"name": "sendgrid_api_key",
			"label": "Sendgrid API key",
			"default": ""
		},
		{
			"type": "text",
			"name": "sendgrid_list_id",
			"label": "Sendgrid list ID",
			"default": "",
			"help": "Optional. If not set, will be added to global contacts"
		}
	]
}
